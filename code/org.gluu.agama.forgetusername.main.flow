Flow org.gluu.agama.forgetusername.main
     Basepath ""
// Create  variable for UCreate  variable for UI feedbackI feedback
uiFeedback = {}
// forgetusernameService
forgetusernameService = Call org.gluu.agama.usernameclass.UsernameResendclass#getInstance 
// userInput
userInput = RRF "InputEmail.ftlh" uiFeedback
email = userInput.mail
Log "@info User mail ++++++++++++++++++++++" email
userData = Call forgetusernameService getUserEntityByMail email
// "users details+++++++"
Log "@info users details+++++++" userData
When userData is not null
     isActive = userData.active
     // "users status ++++++++++++" isActive
     Log "@info users status ++++++++++++" isActive
     // Active status
     When isActive is "true"
          username = userData.uid
          lang = userData.lang
          phone = userData.phone
          Log "@info username lang phone:++++++++++++++++ " username lang phone
          // Phone number check
          When phone is not null
               // sms otpSent
               smsOtpSend = Call forgetusernameService sendOtpToPhone phone lang
               // OTP sent result: ++++++++
               Log "@info OTP sent result: ++++++++" smsOtpSend
               When smsOtpSend is not null
                    otpUiFeedback = {}
                    otpUiFeedback.errorMessage = ""
                    resendCount = 0
                    validationAttempts = 0
                    // maxOtpsent
                    maxOtpsent = Repeat 10 times max
                         //  Show UI to collect OTP code from user.
                         otpCreds = RRF "VerifyOtp.ftlh" otpUiFeedback
                         When otpCreds.hasRequestedNewCode is "yes"
                              // User requested a new OTP code.
                              Log "@info User requested a new OTP code."
                              When resendCount is 3
                                   // Maximum resend attempts exceeded
                                   Log "@info " Maximum resend attempts exceeded
                                   // {success: false, error: "ExceededResendAttempts"}
                                   it_resend = {success: false, error: "ExceededResendAttempts"}
                                   // it_resend
                                   Finish it_resend
                              // Increment resend counter
                              resendCount = Call org.gluu.agama.forgetusername.CounterHelper#increment resendCount
                              // "Resend attempt number: " resendCount
                              Log "@info Resend attempt number: " resendCount
                              // resendResult
                              resendResult = Call forgetusernameService sendOtpToPhone phone lang
                              When resendResult is null
                                   // "Fail to resend new code to user. " resendResult
                                   Log "@info Fail to resend new code to user. " resendResult
                                   // "Error occurs while sending new code to you. Please contact site administrator."
                                   otpUiFeedback.errorMessage = "Error occurs while sending new code to you. Please contact site administrator."
                                   otpUiFeedback.infoMessage = ""
                                   isResending = true
                              // New OTP code send successfully!
                              Log "@info New OTP code send successfully!" resendResult
                              // "A new OTP code has been send to you on your mobile phone."
                              otpUiFeedback.infoMessage = "An OTP code has been send to your register mobile number."
                              otpUiFeedback.errorMessage = ""
                              isResending = true
                         Otherwise
                              //  Add log entry with collected code in log file.
                              Log "@info Information provided by the user is : " otpCreds.code
                              // validationAttempts
                              validationAttempts = Call org.gluu.agama.forgetusername.CounterHelper#increment validationAttempts
                              // Add log entry withvalidation result in log file.
                              Log "@info Validation attempt number: " validationAttempts
                              // Check validation
                              When validationAttempts is 4
                                   // Log validation exceeded
                                   Log "@info Maximum validation attempts exceeded"
                                   // Set validation error
                                   it_otpmax = { success: false, error: "ExceededTheNumberOfAttemptsAllowed" }
                                   // End validation exceeded
                                   Finish it_otpmax
                              Otherwise
                                   //  Validate the OTP code provided by the user.
                                   otpValidationResult = Call forgetusernameService validateOTPCode phone otpCreds.code
                                   // Add log entry withvalidation result in log file.
                                   Log "@info OTP validation result is:" otpValidationResult
                                   // If otp validation was successful
                                   When otpValidationResult is true
                                        Log "@ " __________
                                   Otherwise
                                        // The maximum number of attempt has been reached.
                                        Log "@info Invalid code provided "
                                        // Provide feedback
                                        otpUiFeedback.errorMessage = "Invalid code provided."
                                        otpUiFeedback.infoMessage = ""
               Otherwise
                    // "Failed to send OTP to your phone. Please try again."
                    uiFeedback.errorMessage = "Failed to send OTP to your phone. Please try again."
                    // OTP sending failed for
                    Log "@error OTP sending failed for: " phone
                    // OTP sending failed for: 
                    Finish uiFeedback.errorMessage
          Otherwise
               // No phone on account, sending email directly
               Log "@info No phone on account, sending email directly ++++++++++++" username lang
               sendMailed = Call forgetusernameService sendUsernameEmail email username lang
               // "Email send to user++++" sendMailed
               Log "@info Email send to user++++" sendMailed
               // acknowledgementEmail.ftlh
               RRF "acknowledgementEmail.ftlh" uiFeedback
               Finish username
     Otherwise
          uiFeedback.errorMessage = "Your account is not active. Please contact support."
          Log "@error  Inactive account for email: " email
          Finish uiFeedback.errorMessage
Otherwise
     // Assigns the error message for logs or display later
     uiFeedback.errorMessage = "Invalid email address. User does not exist."
     // Logs the invalid email entered
     Log "@error Invalid email entered: " email
     // End the Flow
     Finish uiFeedback.errorMessage